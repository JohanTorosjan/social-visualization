<div class="type-navigation">
  {{!-- Bouton gauche --}}
  <div class="nav-button left">
    <button type="button" {{on "click" this.previousType}}>&lt;</button>
  </div>

  {{!-- Type actif centré --}}
  <div class="active-type">
    {{format-type this.activeType}}
  </div>
   <p class="number-of-posts"> {{this.numberOfPosts}} posts</p>

  {{!-- Bouton droit --}}
  <div class="nav-button right">
    <button type="button" {{on "click" this.nextType}}>&gt;</button>
  </div>

  {{!-- Liste des types en bas --}}
    
    <div class="types-list">
{{#if this.types}}
  {{#each this.types as |type|}}
    <button
      type="button"
      class="{{if (eq type this.activeType) "active"}}"
      {{on "click" (fn this.setActiveType type)}}
    >
      {{format-type type}}<br/>
    </button>
  {{/each}}
{{else}}
  {{!-- Loader circulaire --}}
  <div class="loader"></div>
{{/if}}
  </div>
</div>
