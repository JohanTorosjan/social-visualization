

<h2>Post Graph</h2>
<p>Nombre total de posts : {{this.posts.length}}</p>

<div class="graph-navigation">

<TypeNavigation @type={{this.activeType}} 
@allTypes={{this.allTypes}}
@onTypeChange={{this.setActiveGraph}} />
</div>

{{#if this.activeType}}
  <h3>Type : {{this.activeType}}</h3>
  <Graph @type={{this.activeType}} />
{{/if}}