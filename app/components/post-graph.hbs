<div class="graph-section">
  <div class="graph-wrapper">
    <div class="graph-navigation">
      <TypeNavigation @activeType={{this.activeType}} @onTypeChange={{this.setActiveGraph}} />
    </div>
    <div class="graph-container">
      <Graph @type={{this.activeType}} @size={{graph-size this.windowWidth}} />
    </div>
  </div>
</div>