{{!-- Header avec le switch et le compteur --}}
<Header @posts={{this.posts.length}} />

<div class="graph-section">

  <div class="graph-wrapper">
    
    {{!-- Barre de navigation des types --}}
    <div class="graph-navigation">
      <TypeNavigation @type={{this.activeType}} 
                      @allTypes={{this.allTypes}}
                      @onTypeChange={{this.setActiveGraph}} />
    </div>

    {{!-- Fond du graphe + gestion du message si non affichable --}}
    <div class="graph-container">
      {{#if (gt this.windowWidth 900)}}
          <Graph @type={{this.activeType}} />
      {{else}}
        <h1 class="graph-message">Sorry, your screen is too small to display this graph</h1>
      {{/if}}
    </div>

  </div>
</div>
